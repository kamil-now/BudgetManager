{
  "AllowedHosts": "*",
  "JwtTokenSettings": {
    "Secret": "super-secret-key-for-testing-purposes-only",
    "Issuer": "BudgetManager_Dev_Issuer",
    "Audience": "BudgetManager_Dev_Audience",
    "ExpirationMinutes": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "BudgetManager": "Information",
        "Microsoft.Hosting.Lifetime": "Information",
        "Serilog.AspNetCore": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  }
}